# Valence Environment Configuration Template

# Database: Postgres (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/valence"

# Robinhood Chain Mainnet (Chain ID 4663)
ROBINHOOD_CHAIN_RPC="https://robinhood.api.pocket.network"
ROBINHOOD_CHAIN_ID="4663"
ARBITRUM_ORBIT_RPC="https://rpc.mainnet.chain.robinhood.com"

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="ValenceAlphaBot"

# OpenServ SERV AI Engine
SERV_API_KEY="your_openserv_serv_api_key"
SERV_MODEL="gpt-4o-mini"
SERV_BASE_URL="https://inference-api.openserv.ai/v1"

# Scheduler Security Secret
CRON_SECRET="valence-cron-secure-secret-2026"

# Next.js Application URL (Set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL="https://valence.vercel.app"
NEXT_PUBLIC_DEFAULT_WALLET="0x71C43939626A3b8A88a8f1B5D34559828e184e8B"

# Logo.dev Stock Ticker Logos API (https://www.logo.dev)
NEXT_PUBLIC_LOGO_DEV_TOKEN="pk_GyuktWeZTOaELO6mQpM8Xg"

# Email Delivery (Resend - https://resend.com)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Valence Security <onboarding@resend.dev>"

# Google OAuth (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
